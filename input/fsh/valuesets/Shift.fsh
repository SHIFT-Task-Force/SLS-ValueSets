Instance: ShiftBHSHIFTSEX
InstanceOf: ValueSet
Usage: #definition
Title: "SHIFT SEX"
Description: """
A patient's sexuality and sexual history, including sexual orientation, sexual practices, and sexual partners. Female sexual dysfunction is classified here. Male sexual dysfunction is classified here AND ALSO under SHIFT FERTILITY.

Identified as: v3-ActCode#SEX
"""
* name = "ShiftBHSHIFTSEX"
* url = "http://SHIFT-Task-Force.github.io/SLS-ValueSets/ValueSet/ShiftBHSHIFTSEX"
* status = #active
* experimental = false
* version = "0.1.0"
* date = "2026-08-01"
* useContext[+].code = http://terminology.hl7.org/CodeSystem/usage-context-type#focus
// useContext mapping: SHIFT SEX -> v3-ActCode#SEX
* useContext[=].valueCodeableConcept = http://terminology.hl7.org/CodeSystem/v3-ActCode#SEX
* compose.inactive = true
